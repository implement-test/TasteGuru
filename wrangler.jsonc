{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasteguru",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // 대시보드에서 등록한 일반 변수를 배포 때 지우지 않음
  "keep_vars": true,
  "routes": [{ "pattern": "tasteguru.nogamenogain.com", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://tasteguru.nogamenogain.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tasteguru-db",
      "database_id": "607fff35-ce1e-4c4b-bb44-95e1c227a82b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tasteguru-media" }]
}
